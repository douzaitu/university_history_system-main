# 此文件是样板配置。请将此文件复制为 .env 并填写您的真实信息。
# This is a sample config file. Copy this to .env and fill in your values.

# DeepSeek API (AI 问答)
DEEPSEEK_API_KEY=your_api_key_here

# Neo4j Database (知识图谱)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# PostgreSQL Database (核心数据)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_history_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Django Security
DJANGO_SECRET_KEY=generate_a_random_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True